rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'fauzan.kurniawan.2402316@students.um.ac.id' ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'fauzan.kurniawan.2402316@students.um.ac.id') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default deny catch-all: any unmatched path is strictly rejected
    match /{document=**} {
      allow read, write: if false;
    }

    // Strict User-Isolated Data:
    // Setiap user hanya memiliki izin membaca dan menulis datanya sendiri (Zero-Trust)
    match /users/{userId} {
      // User hanya dapat membaca profil pribadinya sendiri, user lain dilarang
      allow get: if isOwner(userId) || isAdmin();
      // Listing seluruh user hanya diizinkan untuk admin (mencegah scraping user data)
      allow list: if isAdmin();
      // User hanya dapat membuat dan memperbarui datanya sendiri
      allow create, update: if isOwner(userId) || isAdmin();
      // User atau admin dapat menghapus akunnya sendiri
      allow delete: if isOwner(userId) || isAdmin();

      // Subkoleksi progres belajar menyimak per video (hanya user pemilik yang bisa baca/tulis)
      match /progress/{videoId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Subkoleksi catatan istima' pribadi (hanya user pemilik yang bisa baca/tulis)
      match /notes/{noteId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Seluruh subkoleksi turunan user lainnya terproteksi ketat hanya untuk pemiliknya
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Koleksi Materi Video Animasi Pembelajaran
    // Siswa terautentikasi dapat membaca materi, hanya admin yang dapat menambah/mengedit/menghapus
    match /videos/{videoId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Daftar Admin Terpercaya
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
